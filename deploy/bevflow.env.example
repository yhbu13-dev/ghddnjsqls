# /etc/bevflow.env  (chmod 600, root 소유)
PORT=8080
HOST=127.0.0.1
BEVFLOW_DB=/opt/bevflow/data/bevflow.db
# HTTPS 프록시(Caddy) 뒤에서 실행: 세션 쿠키에 Secure, 접속 IP를 X-Forwarded-For에서 읽음
BEVFLOW_TRUST_PROXY=1

# 첫 실행 관리자 (비워 두면 admin@bevflow.local + 임시 비밀번호를 로그에 출력)
#BEVFLOW_ADMIN_EMAIL=ops@example.com
#BEVFLOW_ADMIN_PASSWORD=

# 키를 환경 변수로 고정하려면 (비워 두면 DB에 생성·보관, [관리 → 데이터 연동]에서 재발급)
#BEVFLOW_LINK_SECRET=
#BEVFLOW_INGEST_SECRET=
#BEVFLOW_WEBHOOK_SECRET=
