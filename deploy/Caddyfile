# /etc/caddy/Caddyfile — 도메인의 DNS A 레코드를 이 서버로 향하게 하면 HTTPS 인증서를 자동 발급합니다.
# 서버를 띄운 뒤 [관리 → 운영 설정 → 외부 접속 주소]를 https://ops.example.com 으로 바꾸세요.

ops.example.com {
	encode gzip

	# 운영 콘솔 접근을 사무실 IP로 제한하려면 주석을 풀고 IP를 넣으세요.
	# 사장님 링크(/o/*), 기사 링크(/d/*), POS 수신(/api/ingest/*), 링크 화면용 API는 외부에서 열려 있어야 합니다.
	# @console {
	# 	not path /o/* /d/* /api/owner/* /api/driver/* /api/ingest/* /assets/* /healthz
	# 	not remote_ip 203.0.113.10/32
	# }
	# respond @console 403

	# Caddy가 X-Forwarded-For / X-Forwarded-Proto를 붙입니다 → 서버는 BEVFLOW_TRUST_PROXY=1로 실행
	reverse_proxy 127.0.0.1:8080

	log {
		output file /var/log/caddy/bevflow.log
	}
}
